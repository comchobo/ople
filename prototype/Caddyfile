{
	admin off
	auto_https off
}

http://localhost:8765, http://127.0.0.1:8765 {
	bind 127.0.0.1
	header {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	@foreign expression `{http.request.header.Origin} != '' && !({http.request.header.Origin} in ['http://127.0.0.1:8765', 'http://localhost:8765'])`
	respond @foreign 403
	@home path / /PROTOTYPE.html
	handle @home {
		rewrite * /PROTOTYPE.html
		file_server
	}
	handle /.env.dev {
		header Content-Type text/plain
		respond "OPLE_LOCAL_RELAY=1
OLLAMA_MODEL={env.OLLAMA_MODEL}
CLOUDFLARE_STT_MODEL={env.CLOUDFLARE_STT_MODEL}"
	}
	@chat {
		method POST
		path /voice/chat
		header X-Ople-Request interview
	}
	handle @chat {
		rewrite * /api/chat
		reverse_proxy https://ollama.com {
			header_up Host ollama.com
			header_up Authorization "Bearer {env.OLLAMA_API_KEY}"
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	@audio {
		method POST
		path /voice/audio
		header X-Ople-Request interview
	}
	handle @audio {
		rewrite * /client/v4/accounts/{env.CLOUDFLARE_ACCOUNT_ID}/ai/run/{env.CLOUDFLARE_STT_MODEL}
		reverse_proxy https://api.cloudflare.com {
			header_up Host api.cloudflare.com
			header_up Authorization "Bearer {env.CLOUDFLARE_API_TOKEN}"
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}
