      "css": ".ds-hero{display:inline-flex;align-items:center;justify-content:space-between;gap:10px;cursor:pointer;width:100%;border:1px solid transparent;background:var(--paper);color:var(--ink);border-radius:6px;min-height:64px;padding:18px 24px;font:550 17px/1.4 \"Pretendard Variable\",Pretendard,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-hero svg{width:18px;height:18px;flex-shrink:0}.ds-hero:hover{background:var(--butter);border-color:transparent}.ds-hero:focus-visible{outline:2px solid var(--accent-dark);outline-offset:4px}.ds-hero:disabled{cursor:not-allowed;opacity:.5}@media(max-width:760px){.ds-hero{min-height:58px}}@media(prefers-reduced-motion:reduce){.ds-hero{transition:none}}"
