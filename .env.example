POSTGRES_USER=ople
POSTGRES_PASSWORD=ople
POSTGRES_DB=ople

# Public browser origin; Google callback is ${APP_ORIGIN}/api/auth/callback.
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false only for local HTTP development; use true with HTTPS in production.
SESSION_COOKIE_SECURE=false

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash:1017
OLLAMA_API_KEY=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

AI_RETRY_COUNT=2
AI_REQUEST_TIMEOUT_SECONDS=90
AI_TOTAL_TIMEOUT_SECONDS=210
AUDIO_ARCHIVE_DIR=/data/audio
AUDIO_MAX_BYTES=20000000
RECORDING_MAX_SECONDS=300
